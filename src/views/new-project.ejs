<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <!-- Bloco de mensagens padrão do curso CSE 340 -->
    <% if (locals.messages) { %>
        <div class="flash-message"><%- locals.messages %></div>
    <% } %>

    <form action="/new-project" method="POST">
        <div class="form-group">
          <label for="title">Project Title</label>
          <input
            type="text"
            id="title"
            name="title"
            maxlength="200"
            value="<%= locals.projectTitle || '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            maxlength="1000"
            required
          ><%= locals.description || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="location">Location</label>
          <input
            type="text"
            id="location"
            name="location"
            maxlength="200"
            value="<%= locals.location || '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="date">Date</label>
          <input
            type="date"
            id="date"
            name="date"
            value="<%= locals.date || '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="organizationId">Organization</label>
          <select
            id="organizationId"
            name="organizationId"
            required
          >
            <option value="">Select an organization</option>
            <% organizations.forEach(org => { %>
              <option 
                value="<%= org.organization_id %>"
                <%= (locals.organizationId == org.organization_id) ? 'selected' : '' %>
              >
                <%= org.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <button type="submit">Create Project</button>
    </form>

</main>
<%- include('partials/footer') %>
