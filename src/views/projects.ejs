<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    
    <ul>
        <% projects.forEach(project => { %>
            <% 
                // Format date for better readability
                const dateObj = new Date(project.date);
                const formattedDate = dateObj.toLocaleDateString('en-US', { 
                    year: 'numeric', month: 'long', day: 'numeric' 
                });
            %>
            <li>
                <strong>
                    <a href="/project/<%= project.project_id %>">
                        <%= formattedDate %>: <%= project.title %>
                    </a>
                </strong> 
                
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                
                <br>
                <em><%= project.description %></em>
                <br>
                Location: <%= project.location %>
            </li>
        <% }); %>
    </ul>
    <p><a href="/new-project">Add a New Service Project</a></p>
</main>
<%- include('partials/footer') %>