<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (locals.messages) { %>
        <div class="flash-message"><%- locals.messages %></div>
    <% } %>

    <form action="/new-category" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <!-- Maximum length 100 characters on client side, no minimum length attribute so server-side can be tested -->
            <input
                type="text"
                id="name"
                name="name"
                maxlength="100"
                required
            />
        </div>

        <button type="submit">Create Category</button>
    </form>
</main>
<%- include('partials/footer') %>
