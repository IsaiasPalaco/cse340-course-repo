<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <!-- Flash message interface engine for server responses -->
    <% if (locals.messages) { %>
        <div class="flash-message"><%- locals.messages %></div>
    <% } %>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                maxlength="200"
                value="<%= project.title %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="200"
                value="<%= project.location %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <% 
                // Convert database date object safely into standard YYYY-MM-DD format for HTML5 inputs
                let rawDate = new Date(project.date);
                let isoDateString = !isNaN(rawDate.getTime()) ? rawDate.toISOString().split('T')[0] : '';
            %>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= isoDateString %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option 
                        value="<%= org.organization_id %>"
                        <%= (project.organization_id === org.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>
