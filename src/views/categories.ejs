<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <!-- Action trigger to navigate to the creation workspace form -->
    <p style="margin-bottom: 20px;">
        <a href="/new-category" class="btn-edit">Add New Category</a>
    </p>

    <!-- Flash message block to display successful operations or errors -->
    <% if (locals.messages) { %>
        <div class="flash-message"><%- locals.messages %></div>
    <% } %>
    
    <ul>
        <% categories.forEach(category => { %>
            <li style="margin-bottom: 10px; display: flex; align-items: center; gap: 15px;">
                <strong>
                    <a href="/category/<%= category.category_id %>" class="category-link">
                        <%= category.name %>
                    </a>
                </strong>
                <!-- Inline control link to edit this specific category record -->
                <a href="/edit-category/<%= category.category_id %>" class="btn-edit" style="font-size: 0.85em; padding: 2px 8px;">Edit</a>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
